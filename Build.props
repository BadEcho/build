<Project>
	<PropertyGroup>				
		<!--
			Points to the directory above this file, which will be the consuming repository's root if the standard layout is being followed (<repo>\build\Build.props).
			We use this path to break any dependency on $(SolutionDir), which is not always present, and can lead to strange results such as output getting written to 
			the root of the current drive, etc.
		-->
		<OutputRoot Condition="'$(OutputRoot)' == ''">$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))))</OutputRoot>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>$(MSBuildProjectName)</PackageId>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/BadEcho/build</RepositoryUrl>
		<PackageProjectUrl>https://badecho.com</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Authors>Matt Weber</Authors>
		<Company>Bad Echo LLC</Company>
		<Copyright>© Bad Echo LLC. All rights reserved.</Copyright>
		<PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
		<PackageIcon>Icon.png</PackageIcon>
		<NeutralLanguage>en-US</NeutralLanguage>
		<RootNamespace>$(MSBuildProjectName)</RootNamespace>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<Nullable>enable</Nullable>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CLSCompliant>true</CLSCompliant>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8613;CS8625;CS8629;CS8614;CS8618;CS8619;CS8633</WarningsAsErrors>
		<UseCommonOutputDirectory>false</UseCommonOutputDirectory>
		<IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
		<ImplicitUsings>true</ImplicitUsings>
		<DefineConstants>$(DefineConstants);CODE_ANALYSIS</DefineConstants>
		<AnalysisMode>All</AnalysisMode>
		<!--Our custom build task provides the source revision information, which will be the short hash for the commit. The full hash appended by the runtime is too much for my tastes.-->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(OutputRoot)media\Icon.png" Pack="true" PackagePath="">
			<Link>Properties\Icon.png</Link>
		</None>
	</ItemGroup>

	<ItemGroup Condition="!$(MSBuildProjectFullPath.StartsWith($(MSBuildThisFileDirectory))) And $(MSBuildProjectExtension) != '.wixproj'">
		<PackageReference Include="BadEcho.Build" Version="0.1.8" PrivateAssets="all" />
	</ItemGroup>

	<!--
		$(Configuration) isn't defaulted until the SDK's targets are ran, way after this file is evaluated. This means the Configuration-conditioned groups will essentially be skipped
		for builds that don't explicitly pass the build configuration as a global property.
	-->
	<PropertyGroup>
		<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputPath>$(OutputRoot)bin\dbg</OutputPath>
		<DocumentationFile>$(OutputRoot)bin\dbg\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<OutputPath>$(OutputRoot)bin\rel</OutputPath>
		<DocumentationFile>$(OutputRoot)bin\rel\$(AssemblyName).xml</DocumentationFile>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)\strongNaming.snk</AssemblyOriginatorKeyFile>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!--This is needed in order to prevent inaccurate errors from being displayed during design-time.-->
	<Target Name="DisableDesignTimeCompileCheck" AfterTargets="_CheckCompileDesignTimePrerequisite">
		<PropertyGroup>
			<BuildingProject>false</BuildingProject>
		</PropertyGroup>
	</Target>

	<!--
		This guards against $(OutputPath) ever being pointed to the root of the current drive. While having output being written to the top-level directory is almost always going to be unwanted, this additional layer
		of protection was added due to drive-rooted output triggering strange and unwanted behavior with a particular third party tool used by some of my projects.
	-->
	<Target Name="ValidateOutputPath" BeforeTargets="PrepareForBuild">				
		<Error Condition="$(OutputPath.StartsWith('\')) OR $(OutputPath.StartsWith('/'))" Text="OutputPath points to the top-level directory of the current drive, terminating build so output isn't written to the current drive's root."/>
	</Target>
</Project>